---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getShowImage } from "../utils/images";
import FormattedDate from "../components/FormattedDate.astro";
import { IMAGE_WIDTHS, IMAGE_SIZES } from "../utils/imageSizes";
import MediaCard from "./media/MediaCard.astro";

type Media = CollectionEntry<"show">;
type Props = Media["data"] & {
  slug?: Media["id"];
  loading?: "lazy" | "eager";
  latestEpisodeDate?: Date | null;
};

const { title, image, slug, speakers, episodeCount, lastUpdate, latestEpisodeDate, loading = "lazy" } = Astro.props;
const lastUpdateDate = latestEpisodeDate ?? new Date(lastUpdate);
const posterImage = getShowImage(slug, false);
const href = `/show/${slug}/`;
---

<a href={href} class="show-link">
  <MediaCard title={title} variant="show">
    <div slot="image" class="media-image square shadow">
      {posterImage ? (
        <Image
          src={posterImage}
          alt={title}
          widths={[...IMAGE_WIDTHS.extraLarge]}
          sizes={IMAGE_SIZES.card}
          loading={loading}
          decoding="async"
        />
      ) : image ? (
        // image is ImageMetadata from content collection, use it directly
        <Image
          src={image}
          alt={title}
          widths={[...IMAGE_WIDTHS.extraLarge]}
          sizes={IMAGE_SIZES.card}
          loading={loading}
          decoding="async"
        />
      ) : null}
    </div>
    <div slot="subtitle" class="speakers">{speakers.join(", ")}</div>
    <div slot="meta" class="meta">
      <span><FormattedDate date={lastUpdateDate} /></span>
      <span>•</span> <span>{episodeCount} episodes</span>
    </div>
  </MediaCard>
</a>

<style>
  /* MediaCard's own wrapper is a <div> (Video/PodcastCard have separate
     image/title links, so it can't be the single link itself), but a
     show card has always been one link covering the whole card - wrap
     it from outside instead of changing MediaCard's root element. */
  .show-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .media-image {
    transition: box-shadow 1s ease-out;
    aspect-ratio: 1 / 1;
    max-height: fit-content;
    border-radius: var(--radius-6);
    overflow: hidden;
  }
  .media-image img {
    max-width: 100%;
    height: auto;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  /* .meta is "show" variant's tighter 13px (vs 14px for Video/Podcast).
     .speakers reuses the same base styling plus the 15px size override
     that line has always had. Both are slotted content (this file's own
     scope, not MediaCard's), so each is defined fully, locally. */
  .meta {
    font-size: var(--font-size-13);
    color: var(--tx-3);
    display: flex;
    flex-direction: row;
    gap: var(--space-8);
  }
  .speakers {
    font-size: var(--font-size-15);
    color: var(--tx-3);
    display: flex;
    flex-direction: row;
    gap: var(--space-8);
  }
</style>
