---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import FormattedDate from "../components/FormattedDate.astro";
import MediaImage from "./media/MediaImage.astro";
import MediaCard from "./media/MediaCard.astro";
import { formatDuration } from "../utils/formatDuration";
import { IMAGE_WIDTHS, IMAGE_SIZES } from "../utils/imageSizes";

type Media = CollectionEntry<"media">;
type Props = Media["data"] & {
  slug?: Media["id"];
  loading?: "lazy" | "eager";
};

const {
  title,
  publishedAt,
  duration,
  poster,
  slug,
  layoutType = "grid",
  loading = "lazy",
} = Astro.props;

const isImageMetadata = poster && typeof poster === 'object' && 'src' in poster;
const href = `/video/${slug}/`;
---

<MediaCard
  title={title}
  titleHref={href}
  layoutType={layoutType}
  mobileGridColumns="2fr-3fr"
>
  <a href={href} slot="image" class="media-image">
    {isImageMetadata ? (
      <Image
        src={poster as ImageMetadata}
        alt={title}
        widths={[...IMAGE_WIDTHS.large]}
        sizes={IMAGE_SIZES.large}
        loading={loading}
      />
    ) : (
      <MediaImage src={poster} alt={title} ratio="video" loading={loading} />
    )}
  </a>
  <div slot="meta" class="meta">
    <span><FormattedDate date={publishedAt} /></span>
    <span>•</span>
    <span>{formatDuration(duration)}</span>
  </div>
</MediaCard>

<style>
  .media-image img {
    border-radius: var(--radius-6);
    /* The Image branch above (used for every already-downloaded local
       poster) had no aspect-ratio/crop enforcement, unlike MediaImage's
       ratio="video" branch below it - it silently relied on every source
       poster already being 1280x720. A 4:3 YouTube hqdefault.jpg fallback
       (used when maxresdefault isn't available) exposed that: its real
       16:9 video content is letterboxed with black bars top/bottom inside
       the 4:3 canvas. Cropping to this card's actual aspect ratio, centered,
       cuts off almost exactly those bars instead of stretching or padding
       around them - a true 16:9 source is unaffected (nothing to crop).*/
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  @media screen and (max-width: 768px) {
    .media-image {
      border-radius: var(--radius-2);
    }
  }

  .meta {
    font-size: var(--font-size-14);
    color: var(--tx-3);
    display: flex;
    flex-direction: row;
    gap: var(--space-8);
  }
</style>
