---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import { formatDuration } from "../utils/formatDuration";
import { getShowImage } from "../utils/images";
import MediaImage from "./media/MediaImage.astro";
import MediaCard from "./media/MediaCard.astro";

type Media = CollectionEntry<"podcast">;
type Props = Media["data"] & {
  slug?: Media["id"];
  layoutType?: "grid" | "list";
  loading?: "lazy" | "eager";
};

const {
  title,
  publishedAt,
  duration = "",
  image,
  slug,
  hasEpisodeImage,
  showSlug,
  podcastTitle,
  layoutType = "grid",
  loading = "lazy",
} = Astro.props;

// If episode has its own image, use it; otherwise, use show poster
const showPoster = getShowImage(showSlug, false);
// Use ImageMetadata objects directly, not .src strings
const imageToUse = (hasEpisodeImage && image) ? image : showPoster;

const isListLayout = layoutType === "list";
const href = `/podcast/${slug}/`;
---

<MediaCard title={title} titleHref={href} layoutType={layoutType} listAlign="start">
  <a href={href} slot="image" class="media-podcast-image">
    <MediaImage
      src={imageToUse}
      alt={title}
      duration={duration.toString()}
      variant="podcast-duration"
      showDuration={!isListLayout}
      loading={loading}
    />
  </a>
  <a href={`/show/${showSlug}/`} slot="subtitle" class="meta showTitle">{podcastTitle}</a>
  <div slot="meta" class="meta">
    <span><FormattedDate date={publishedAt} /></span> {isListLayout &&
    <span>•</span> <span>{formatDuration(duration)}</span>
  }
  </div>
</MediaCard>

<style>
  /* MediaImage defaults to a square (1:1) image, but podcast episode
     artwork/thumbnails render at 16:9 here - override it. This targets
     an <img> rendered by the nested MediaImage component, not by this
     file, so it needs :global() to cross that scope boundary. */
  .media-podcast-image :global(img) {
    max-width: 100%;
    height: auto;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .meta {
    font-size: var(--font-size-14);
    color: var(--tx-3);
    display: flex;
    flex-direction: row;
    gap: var(--space-8);
  }

  a.showTitle {
    font-size: var(--font-size-15);
    font-weight: var(--font-weight-regular);
    color: var(--tx-2);
    text-decoration: none;
  }
  a.showTitle:hover {
    text-decoration: underline;
  }
</style>
