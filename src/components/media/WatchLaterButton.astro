---
// Save/unsave button for the shared watch-later feature. Rendered inside
// VideoCard/PodcastCard image slots (and could extend to detail pages
// later). All instances on a page share one delegated click handler and
// one watch-later-list fetch (see the script below) rather than each
// button querying Supabase on its own.
import { Icon } from "astro-icon/components";

export interface Props {
  contentType: "media" | "podcast";
  slug: string;
}

const { contentType, slug } = Astro.props;
---

<button
  type="button"
  class="watch-later-btn"
  data-content-type={contentType}
  data-content-slug={slug}
  aria-label="Save to watch later"
  title="Save to watch later"
>
  <Icon name="fluent:bookmark-20-regular" size={16} class="icon-unsaved" />
  <Icon name="fluent:bookmark-20-filled" size={16} class="icon-saved" />
</button>

<style>
  .watch-later-btn {
    position: absolute;
    top: var(--space-8);
    right: var(--space-8);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: var(--radius-full);
    background: rgba(var(--shadow), 55%);
    color: var(--pure-white, #fff);
    cursor: pointer;
    transition: background-color 150ms ease-out;
  }
  .watch-later-btn:hover {
    background: rgb(var(--accent));
  }
  .watch-later-btn.is-saved {
    background: rgb(var(--accent));
  }
  .icon-saved {
    display: none;
  }
  .watch-later-btn.is-saved .icon-unsaved {
    display: none;
  }
  .watch-later-btn.is-saved .icon-saved {
    display: block;
  }
  .watch-later-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }

  @media screen and (max-width: 768px) {
    .watch-later-btn {
      width: 28px;
      height: 28px;
    }
  }
</style>

<script>
  import { supabase } from "../../lib/supabase/client";

  const BTN_SELECTOR = ".watch-later-btn";

  function keyFor(contentType: string, contentSlug: string) {
    return `${contentType}:${contentSlug}`;
  }

  async function syncButtons() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(BTN_SELECTOR);
    if (buttons.length === 0) return;

    try {
      const { data: sessionData } = await supabase.auth.getSession();
      const session = sessionData.session;

      if (!session) {
        buttons.forEach((btn) => btn.classList.remove("is-saved"));
        return;
      }

      const { data, error } = await supabase
        .from("watch_later")
        .select("content_type, content_slug")
        .eq("user_id", session.user.id);

      if (error) {
        console.error("Failed to load watch later list", error);
        return;
      }

      const saved = new Set(
        (data ?? []).map((row) => keyFor(row.content_type, row.content_slug))
      );
      buttons.forEach((btn) => {
        const key = keyFor(
          btn.dataset.contentType ?? "",
          btn.dataset.contentSlug ?? ""
        );
        btn.classList.toggle("is-saved", saved.has(key));
      });
    } catch (err) {
      console.error("Failed to sync watch later buttons", err);
    }
  }

  document.addEventListener("click", async (event) => {
    const btn = (event.target as HTMLElement)?.closest<HTMLButtonElement>(
      BTN_SELECTOR
    );
    if (!btn) return;

    try {
      const { data: sessionData } = await supabase.auth.getSession();
      const session = sessionData.session;
      if (!session) {
        window.location.href = `/account/sign-in/?redirect=${encodeURIComponent(
          window.location.pathname
        )}`;
        return;
      }

      const contentType = btn.dataset.contentType ?? "";
      const contentSlug = btn.dataset.contentSlug ?? "";
      const isSaved = btn.classList.contains("is-saved");

      btn.disabled = true;
      if (isSaved) {
        const { error } = await supabase
          .from("watch_later")
          .delete()
          .eq("user_id", session.user.id)
          .eq("content_type", contentType)
          .eq("content_slug", contentSlug);
        if (!error) btn.classList.remove("is-saved");
      } else {
        const { error } = await supabase.from("watch_later").insert({
          user_id: session.user.id,
          content_type: contentType,
          content_slug: contentSlug,
        });
        if (!error) btn.classList.add("is-saved");
      }
      btn.disabled = false;
    } catch (err) {
      console.error("Failed to toggle watch later item", err);
      btn.disabled = false;
    }
  });

  syncButtons();
  supabase.auth.onAuthStateChange(() => syncButtons());
</script>
