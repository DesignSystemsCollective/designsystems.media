---
// Public profile shell. This single static page is served for every
// /u/<handle>/ path via the rewrite rule in public/_redirects - the
// handle is read from the URL client-side and resolved against Supabase.
// (The site stays fully static: no per-request server rendering.) That
// means this page isn't pre-rendered per-handle or crawlable the way the
// rest of the site is - acceptable for v1 since public profiles aren't
// the priority.
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Profile";
---

<BaseLayout sidebar={false} metadataProps={{ title }}>
  <div class="public-profile" id="public-profile" hidden>
    <div class="public-profile-avatar" id="public-profile-avatar"></div>
    <h1 id="public-profile-name"></h1>
    <p id="public-profile-handle" class="public-profile-handle"></p>
    <p id="public-profile-bio" class="public-profile-bio"></p>
  </div>
  <p id="public-profile-not-found" class="public-profile-not-found" hidden>
    No profile found for this handle.
  </p>
</BaseLayout>

<style>
  .public-profile {
    max-width: 480px;
    margin: 0 auto;
    padding: var(--space-32) var(--space-16);
    text-align: center;
  }
  .public-profile-avatar {
    width: 80px;
    height: 80px;
    margin: 0 auto var(--space-16);
    border-radius: var(--radius-full);
    background: rgb(var(--accent));
    color: var(--pure-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-20);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
  }
  .public-profile-handle {
    color: var(--tx-3);
    margin: 0 0 var(--space-16);
  }
  .public-profile-bio {
    color: var(--tx-2);
  }
  .public-profile-not-found {
    text-align: center;
    color: var(--tx-2);
    padding: var(--space-32) var(--space-16);
  }
</style>

<script>
  import { supabase } from "../../lib/supabase/client";

  const handle = window.location.pathname
    .replace(/^\/u\//, "")
    .replace(/\/$/, "");

  const profileEl = document.querySelector<HTMLElement>("#public-profile");
  const notFoundEl = document.querySelector<HTMLElement>(
    "#public-profile-not-found"
  );
  const avatarEl = document.querySelector<HTMLElement>(
    "#public-profile-avatar"
  );
  const nameEl = document.querySelector<HTMLElement>("#public-profile-name");
  const handleEl = document.querySelector<HTMLElement>(
    "#public-profile-handle"
  );
  const bioEl = document.querySelector<HTMLElement>("#public-profile-bio");

  async function init() {
    if (!handle) {
      if (notFoundEl) notFoundEl.hidden = false;
      return;
    }

    try {
      const { data: profile, error } = await supabase
        .from("profiles")
        .select("handle, display_name, bio")
        .eq("handle", handle)
        .maybeSingle();

      if (error || !profile) {
        if (notFoundEl) notFoundEl.hidden = false;
        return;
      }

      const name = profile.display_name || profile.handle;
      if (nameEl) nameEl.textContent = name;
      if (handleEl) handleEl.textContent = `@${profile.handle}`;
      if (bioEl) bioEl.textContent = profile.bio || "";
      if (avatarEl) avatarEl.textContent = name.charAt(0);
      if (profileEl) profileEl.hidden = false;
    } catch (err) {
      // A network-level failure (e.g. Supabase unreachable) rejects
      // rather than resolving with {error} - fall back to the same
      // not-found state instead of leaving the page blank.
      console.error("Failed to load profile", err);
      if (notFoundEl) notFoundEl.hidden = false;
    }
  }

  init();
</script>
