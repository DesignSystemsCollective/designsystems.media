---
import Card from "../components/Card.astro";
import CardHeader from "../components/CardHeader.astro";
import LibraryStats from "../components/LibraryStats.astro";
import MediaGrid from "../components/MediaGrid.astro";
import PodcastGrid from "../components/PodcastGrid.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Sponsors from "../components/Sponsors.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveGrid from "../layouts/ResponsiveGrid.astro";
import { getRecentPodcasts, getRecentVideos, getTaxonomyIndex } from "../lib/content-domain";
import type { TaxonomyItem } from "../lib/content-domain/types";

const [recentVideos, recentPodcasts, topicsIndex, seriesIndex, toolsIndex] = await Promise.all([
  getRecentVideos(12),
  getRecentPodcasts(12),
  getTaxonomyIndex("topics"),
  getTaxonomyIndex("series"),
  getTaxonomyIndex("tools"),
]);

// "Popular" = most content behind it, not a hand-picked list - now that
// series/topics/tools are real, migrated facets (ADR 0012/0013) rather
// than empty placeholders, the homepage can surface whichever four
// terms in each facet actually have the most videos/podcasts, and it
// stays correct as new content is tagged instead of drifting stale.
function topByCount(items: TaxonomyItem[], limit = 4): TaxonomyItem[] {
  return [...items].sort((left, right) => right.count - left.count).slice(0, limit);
}

const popularTopics = topByCount(topicsIndex.items);
const popularSeries = topByCount(seriesIndex.items);
const popularTools = topByCount(toolsIndex.items);
---

<BaseLayout sidebar={false} isHome={true}>
  <LibraryStats />
  <Sponsors />
  <SectionHeader
    title="Latest videos"
    link="/all/"
    linkLabel="View all videos"
    padding={true}
  />
  <MediaGrid media={recentVideos} gridItemMinWidth="320px"/>
  <SectionHeader
    title="Latest podcast episodes"
    link="/podcast/"
    linkLabel="View all podcasts"
    padding={true}
  />
  <PodcastGrid media={recentPodcasts}  eagerLoadCount={8} />
  <!-- ADR 0013: three honestly-labeled facets, replacing the old
       topics/speakers/"Popular events" row. "Popular events" used to
       link to plain tag pages for conference names - the exact
       series/topics/tools confusion ADR 0012 diagnoses. These link to
       the /topics/, /series/, /tools/ taxonomies, and now that content
       is migrated onto them, "popular" is computed from actual entry
       counts per term (see topByCount above) rather than a hand-picked
       list, so this row updates itself as tagging changes. -->
  <ResponsiveGrid gridLayoutGap="var(--space-16)" gridColumnCount={3}>
    <Card>
      <CardHeader
        title="Popular topics"
        link="/topics/"
        linkLabel="View all topics"
      />
      <div class="home-content">
        <ul>
          {popularTopics.map((topic) => (
            <li><a href={`/topics/${topic.slug}/`}>{topic.name}</a></li>
          ))}
        </ul>
      </div>
    </Card>
    <Card>
      <CardHeader
        title="Popular series"
        link="/series/"
        linkLabel="View all series"
      />
      <div class="home-content">
        <ul>
          {popularSeries.map((series) => (
            <li><a href={`/series/${series.slug}/`}>{series.name}</a></li>
          ))}
        </ul>
      </div>
    </Card>
    <Card>
      <CardHeader
        title="Popular tools"
        link="/tools/"
        linkLabel="View all tools"
      />
      <div class="home-content">
        <ul>
          {popularTools.map((tool) => (
            <li><a href={`/tools/${tool.slug}/`}>{tool.name}</a></li>
          ))}
        </ul>
      </div>
    </Card>
  </ResponsiveGrid>
</BaseLayout>

<style>
  .home-content {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 0rem;
  }

  .home-content ul {
    display: flex;
    flex-direction: column;
    list-style-type: none;
    padding: 0rem;
    margin-block: 1em 0rem;
  }

  .home-content ul li {
    line-height: 1.2rem;
    margin-block-end: 0.6em;
  }
  .home-content ul:last-child {
    margin-block-end: 0rem;
  }

  .home-content ul li a {
    font-size: 1.2rem;
    color: rgb(var(--accent));
    text-decoration: none;
    line-height: 1.1em;
    border-bottom: 1px solid var(--accent-hover);
    padding: 0.1em 0 0;
  }

  .home-content ul li a:hover {
    color: var(--accent-hover);
  }
</style>
