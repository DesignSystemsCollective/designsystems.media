---
import Card from "../components/Card.astro";
import CardHeader from "../components/CardHeader.astro";
import LibraryStats from "../components/LibraryStats.astro";
import MediaGrid from "../components/MediaGrid.astro";
import PodcastGrid from "../components/PodcastGrid.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Sponsors from "../components/Sponsors.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveGrid from "../layouts/ResponsiveGrid.astro";
import { getRecentPodcasts, getRecentVideos } from "../lib/content-domain";

const [recentVideos, recentPodcasts] = await Promise.all([
  getRecentVideos(12),
  getRecentPodcasts(12),
]);
---

<BaseLayout sidebar={false} isHome={true}>
  <LibraryStats />
  <Sponsors />
  <SectionHeader
    title="Latest videos"
    link="/all/"
    linkLabel="View all videos"
    padding={true}
  />
  <MediaGrid media={recentVideos} gridItemMinWidth="320px"/>
  <SectionHeader
    title="Latest podcast episodes"
    link="/podcast/"
    linkLabel="View all podcasts"
    padding={true}
  />
  <PodcastGrid media={recentPodcasts}  eagerLoadCount={8} />
  <!-- ADR 0013: three honestly-labeled facets, replacing the old
       topics/speakers/"Popular events" row. "Popular events" used to
       link to plain tag pages for conference names - the exact
       series/topics/tools confusion ADR 0012 diagnoses. These links
       point at the new /topics/, /series/, /tools/ taxonomies; they'll
       show empty pages until the migration pass in ADR 0012's Open
       questions actually re-tags content onto them. -->
  <ResponsiveGrid gridLayoutGap="var(--space-16)" gridColumnCount={3}>
    <Card>
      <CardHeader
        title="Popular topics"
        link="/topics/"
        linkLabel="View all topics"
      />
      <div class="home-content">
        <ul>
          <li>
            <a href="/topics/design-tokens/">Design tokens</a>
          </li><li><a href="/topics/accessibility/">Accessibility</a></li><li>
            <a href="/topics/governance/">Governance</a>
          </li><li><a href="/topics/adoption/">Adoption</a></li>
        </ul>
      </div>
    </Card>
    <Card>
      <CardHeader
        title="Popular series"
        link="/series/"
        linkLabel="View all series"
      />
      <div class="home-content">
        <ul>
          <li>
            <a href="/series/design-systems-london/">Design Systems London</a>
          </li><li><a href="/series/converge/">Converge</a></li><li>
            <a href="/series/clarity/">Clarity</a>
          </li><li><a href="/series/dsw-day/">DSW Day</a></li>
        </ul>
      </div>
    </Card>
    <Card>
      <CardHeader
        title="Popular tools"
        link="/tools/"
        linkLabel="View all tools"
      />
      <div class="home-content">
        <ul>
          <li><a href="/tools/figma/">Figma</a></li><li>
            <a href="/tools/supernova/">Supernova</a>
          </li><li><a href="/tools/zeroheight/">Zeroheight</a></li><li>
            <a href="/tools/storybook/">Storybook</a>
          </li>
        </ul>
      </div>
    </Card>
  </ResponsiveGrid>
</BaseLayout>

<style>
  .home-content {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 0rem;
  }

  .home-content ul {
    display: flex;
    flex-direction: column;
    list-style-type: none;
    padding: 0rem;
    margin-block: 1em 0rem;
  }

  .home-content ul li {
    line-height: 1.2rem;
    margin-block-end: 0.6em;
  }
  .home-content ul:last-child {
    margin-block-end: 0rem;
  }

  .home-content ul li a {
    font-size: 1.2rem;
    color: rgb(var(--accent));
    text-decoration: none;
    line-height: 1.1em;
    border-bottom: 1px solid var(--accent-hover);
    padding: 0.1em 0 0;
  }

  .home-content ul li a:hover {
    color: var(--accent-hover);
  }
</style>
