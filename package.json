{
  "name": "designsystems.media",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Frank Congson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DesignSystemsCollective/designsystems.media"
  },
  "scripts": {
    "videos": "node --experimental-strip-types video-aggregator/scripts/getVideos.ts",
    "podcasts": "node --experimental-strip-types video-aggregator/scripts/getPodcasts.ts",
    "images": "node --experimental-strip-types video-aggregator/scripts/getImages.ts",
    "aggregate": "npm run videos && npm run images",
    "validate:content": "node scripts/validate-content.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run validate:content && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "serve": "npx serve -l 4321 dist",
    "test:unit": "node --experimental-strip-types --test src/tests/unit/content-domain.test.ts src/tests/unit/content-domain-selectors.test.ts src/tests/unit/content-validation.test.mjs src/tests/unit/video-aggregator-duration.test.mjs src/tests/unit/video-aggregator-slugs.test.mjs src/tests/unit/video-aggregator-frontmatter.test.mjs src/tests/unit/video-aggregator-shared.test.mjs src/tests/unit/video-aggregator-images.test.mjs src/tests/unit/findFirstExistingImage.test.ts",
    "test:smoke": "npm run build && npx playwright test --project=smoke",
    "test:visual": "npm run build && npx playwright test --project=visual-desktop --project=visual-mobile",
    "test:visual:update": "npm run build && npx playwright test --update-snapshots --project=visual-desktop --project=visual-mobile"
  },
  "dependencies": {
    "@astro-community/astro-embed-youtube": "^0.5.6",
    "@astrojs/mdx": "6.0.3",
    "@astrojs/netlify": "7.0.13",
    "@astrojs/react": "4.2.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "^3.3.0",
    "@iconify-json/fluent": "^1.2.16",
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "astro": "6.4.8",
    "astro-google-analytics": "^1.0.3",
    "astro-icon": "^1.1.5",
    "astro-pagefind": "^1.8.3",
    "axios": "^1.8.4",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.2.3",
    "framer-motion": "^12.16.0",
    "googleapis": "^173.0.0",
    "gray-matter": "^4.0.3",
    "he": "^1.2.0",
    "jsdom": "^26.1.0",
    "markdown-it": "^14.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.34.2",
    "slugify": "^1.6.6",
    "turndown": "^7.2.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "sharp": "0.34.2"
  }
}
