# YouTube Data API v3 key, used by content-aggregator/scripts/video
# https://developers.google.com/youtube/v3/getting-started
API_KEY=

# Podcast Index API credentials, used by content-aggregator/scripts/podcast
# https://api.podcastindex.org/
PODCAST_API_KEY=
PODCAST_API_SECRET=

# Supabase project (accounts/profiles/watch later). PUBLIC_ prefix is
# required for Astro to expose these to client bundles - safe to expose,
# the anon key is meant to be public and row-level security (see
# supabase/migrations/) is what actually restricts access.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
